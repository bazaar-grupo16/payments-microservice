{
  "openapi": "3.1.0",
  "info": {
    "title": "payments-service",
    "version": "0.1.0"
  },
  "paths": {
    "/livez": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "description": "Returns HTTP 200 when the process is alive. No external checks.",
        "operationId": "livez_livez_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Livez Livez Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "description": "Attempts a lightweight database query. Returns HTTP 200 if successful, HTTP 503 otherwise.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/payments/preferences": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Crea una preferencia de pago en MercadoPago.",
        "description": "Se comunica con la API de MP, obtiene el init_point y lo devuelve. Valida idempotencia localmente.",
        "operationId": "create_preference_payments_preferences_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Clave \u00fanica para evitar preferencias duplicadas.",
              "title": "Idempotency-Key"
            },
            "description": "Clave \u00fanica para evitar preferencias duplicadas."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferenceResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          }
        }
      }
    },
    "/payments/{order_id}/status": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Consulta el estado interno del pago asociado a una orden.",
        "description": "Utilizado por el frontend para hacer polling tras volver del deep link.",
        "operationId": "get_payment_status_payments__order_id__status_get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/mp-webhook": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Recibe notificaciones IPN/Webhooks desde MercadoPago.",
        "description": "Endpoint p\u00fablico consumido por MercadoPago. Valida la firma del request, actualiza la base de datos local y dispara el Webhook interno hacia el MS de \u00d3rdenes.",
        "operationId": "mp_webhook_payments_mp_webhook_post",
        "parameters": [
          {
            "name": "x-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Signature"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Mp Webhook Payments Mp Webhook Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/debug": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Endpoint de debug para validar un pago manualmente.",
        "description": "Simula un webhook para aprobar o rechazar un pago.",
        "operationId": "debug_webhook_payments_debug_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DebugPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Debug Webhook Payments Debug Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{order_id}/refund": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Solicita un reembolso de un \u00edtem de pago.",
        "description": "Reembolsa un \u00edtem espec\u00edfico de la orden. Si todos los \u00edtems quedan reembolsados, el pago completo se marca como REFUNDED.",
        "operationId": "request_refund_payments__order_id__refund_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Order Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          }
        }
      }
    },
    "/payments/{order_id}/cancel": {
      "put": {
        "tags": [
          "Payments"
        ],
        "summary": "Cancela un pago pendiente.",
        "description": "Permite cancelar un pago que a\u00fan no ha sido aprobado. Si el pago ya fue aprobado, devuelve un error.",
        "operationId": "cancel_payment_payments__order_id__cancel_put",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCancellationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DebugPaymentRequest": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id",
            "description": "ID de la operaci\u00f3n (orden) a simular."
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "description": "Si el pago fue aceptado o rechazado."
          }
        },
        "type": "object",
        "required": [
          "operation_id",
          "accepted"
        ],
        "title": "DebugPaymentRequest",
        "description": "Body for the debug webhook endpoint."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Standard error body returned by the API."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Descripci\u00f3n del \u00edtem a mostrar en MercadoPago."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity",
            "example": 1
          },
          "unit_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Unit Price",
            "description": "Precio unitario del \u00edtem."
          },
          "line_item_id": {
            "type": "string",
            "title": "Line Item Id",
            "description": "ID \u00fanico del \u00edtem dentro de la orden."
          }
        },
        "type": "object",
        "required": [
          "title",
          "quantity",
          "unit_price",
          "line_item_id"
        ],
        "title": "Item",
        "description": "A single item within a preference request."
      },
      "OrderCancellationResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id",
            "description": "ID de la orden cancelada."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Estado del pago despu\u00e9s de la cancelaci\u00f3n."
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status"
        ],
        "title": "OrderCancellationResponse",
        "description": "Response for a successful order cancellation."
      },
      "PaymentStatusResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id"
          },
          "payment_status": {
            "type": "string",
            "pattern": "^(PENDING|APPROVED|REJECTED|CANCELED|REFUNDED)$",
            "title": "Payment Status",
            "description": "Estado actual del pago."
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "payment_status"
        ],
        "title": "PaymentStatusResponse",
        "description": "Response for ``GET /payments/{order_id}/status``."
      },
      "PreferenceRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id",
            "description": "ID de la orden generada por el orquestador."
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Items",
            "description": "Lista de \u00edtems a cobrar en MercadoPago."
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "items"
        ],
        "title": "PreferenceRequest",
        "description": "Body for ``POST /payments/preferences``."
      },
      "PreferenceResponse": {
        "properties": {
          "preference_id": {
            "type": "string",
            "title": "Preference Id",
            "description": "ID interno de la preferencia de MercadoPago."
          },
          "init_point": {
            "type": "string",
            "title": "Init Point",
            "description": "URL a la que el frontend debe redirigir al usuario para efectuar el pago."
          }
        },
        "type": "object",
        "required": [
          "preference_id",
          "init_point"
        ],
        "title": "PreferenceResponse",
        "description": "Successful response for ``POST /payments/preferences``."
      },
      "RefundRequest": {
        "properties": {
          "order_item_id": {
            "type": "string",
            "title": "Order Item Id",
            "description": "ID del \u00edtem de la orden a reembolsar (line_item_id del item)."
          }
        },
        "type": "object",
        "required": [
          "order_item_id"
        ],
        "title": "RefundRequest",
        "description": "Body for ``POST /payments/{order_id}/refund``."
      },
      "RefundResponse": {
        "properties": {
          "refund_id": {
            "type": "string",
            "title": "Refund Id",
            "description": "ID del reembolso en MercadoPago."
          },
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id",
            "description": "ID de la orden."
          },
          "order_item_id": {
            "type": "string",
            "title": "Order Item Id",
            "description": "ID del \u00edtem reembolsado."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Estado del reembolso."
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Monto reembolsado."
          }
        },
        "type": "object",
        "required": [
          "refund_id",
          "order_id",
          "order_item_id",
          "status",
          "amount"
        ],
        "title": "RefundResponse",
        "description": "Response for a successful refund request."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}