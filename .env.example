# ──────────────────────────────────────────────────────
# Environment variables for the Payments microservice.
# Copy this file to .env and fill in the real values.
# NEVER commit .env with real credentials to the repo.
# ──────────────────────────────────────────────────────

APP_NAME=payments-service
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=bazaar_payments

# ── MercadoPago ──────────────────────────────────────
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=your_webhook_secret_here

# ── Internal Services ────────────────────────────────
ORDERS_SERVICE_URL=http://localhost:8001
